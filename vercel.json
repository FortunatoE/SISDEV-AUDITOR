  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src/**,workflow/**}",
      "excludeFiles": "{dados/**,banco/**,resultados/**,logs/**,tmp/**,tests/**,node_modules/**,*.xlsx,*.xls,*.pbix,*.rar}"
    }
  }
}
